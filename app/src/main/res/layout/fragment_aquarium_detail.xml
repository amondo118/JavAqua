<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".myaqua.AquariumDetailFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/textViewAquariumNameLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aquarium Name:"
            android:textColor="?android:attr/textColorSecondary"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textViewAquariumName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="?android:attr/textColorPrimary"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            app:layout_constraintBaseline_toBaselineOf="@+id/textViewAquariumNameLabel"
            app:layout_constraintStart_toEndOf="@+id/textViewAquariumNameLabel"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="My Awesome Tank" />

        <com.example.javaqua.myaqua.AnimatedAquariumView
            android:id="@+id/animatedAquariumView"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/textViewAquariumName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/textViewAquariumVolumeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Volume (Liters):"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/animatedAquariumView" />

        <TextView
            android:id="@+id/textViewAquariumVolume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintBaseline_toBaselineOf="@+id/textViewAquariumVolumeLabel"
            app:layout_constraintStart_toEndOf="@+id/textViewAquariumVolumeLabel"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="240" />

        <TextView
            android:id="@+id/textViewAquariumTemperatureLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Temperature (°C):"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textViewAquariumVolumeLabel" />

        <TextView
            android:id="@+id/textViewAquariumTemperature"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintBaseline_toBaselineOf="@+id/textViewAquariumTemperatureLabel"
            app:layout_constraintStart_toEndOf="@+id/textViewAquariumTemperatureLabel"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="25.5" />

        <TextView
            android:id="@+id/textViewFishInAquariumTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Fish in this Aquarium"
            android:textColor="?android:attr/textColorPrimary"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textViewAquariumTemperature" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewFishInAquarium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/textViewFishInAquariumTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_fish_preview" /> <!-- tools:listitem for preview -->

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>