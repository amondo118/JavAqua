<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".myaqua.AddAquariumFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textViewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Aquarium"
                android:textColor="?android:attr/textColorPrimary"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                android:layout_marginBottom="24dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/nameInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Aquarium Name"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="24dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextAquariumName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Volume (Liters)"
                android:textColor="?android:attr/textColorSecondary"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0.0"
                android:valueTo="500.0"
                android:stepSize="5.0"
                app:labelBehavior="withinBounds" />

            <TextView
                android:id="@+id/textViewVolumeDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 L"
                android:layout_gravity="end"
                android:layout_marginBottom="16dp"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Temperature (°C)"
                android:textColor="?android:attr/textColorSecondary"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderTemp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="15.0"
                android:valueTo="35.0"
                android:stepSize="0.5"
                android:value="25.0"
                app:labelBehavior="withinBounds" />

            <TextView
                android:id="@+id/textViewTempDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25.0 °C"
                android:layout_gravity="end"
                android:layout_marginBottom="24dp"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Background"
                android:textColor="?android:attr/textColorSecondary"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:layout_marginBottom="8dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewBackgrounds"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_background_preset" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inhabitants"
                android:textColor="?android:attr/textColorSecondary"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:layout_marginBottom="8dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewSelectedFish"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_selected_fish" />

            <Button
                android:id="@+id/buttonAddFish"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:text="Add Fish"
                app:icon="@android:drawable/ic_input_add" />

            <Button
                android:id="@+id/buttonSaveAquarium"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save Aquarium" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Overlay Fish Selection Section -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fishSelectionSection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/windowBackground"
        android:visibility="gone"
        tools:visibility="gone">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/searchFishLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:hint="Search species..."
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextSearchFish"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewAllFish"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@id/searchFishLayout"
            app:layout_constraintBottom_toTopOf="@id/buttonFinishSelection"
            tools:listitem="@layout/item_selectable_fish" />

        <Button
            android:id="@+id/buttonFinishSelection"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="Finish Adding"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>