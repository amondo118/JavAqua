<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <TextView
        android:id="@+id/textViewCommentUsername"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="CommenterUsername" />

    <TextView
        android:id="@+id/textViewCommentTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textSize="12sp"
        app:layout_constraintBaseline_toBaselineOf="@+id/textViewCommentUsername"
        app:layout_constraintStart_toEndOf="@+id/textViewCommentUsername"
        tools:text="1h ago" />

    <TextView
        android:id="@+id/textViewCommentText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewCommentUsername"
        tools:text="This is a sample comment text that might be multiple lines long." />

    <!-- Upvote -->
    <ImageButton
        android:id="@+id/buttonCommentUpvote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Upvote Comment"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewCommentText"
        app:srcCompat="@android:drawable/arrow_up_float"
        app:tint="?attr/colorPrimary" />

    <TextView
        android:id="@+id/textViewCommentUpvoteCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
        app:layout_constraintBottom_toBottomOf="@+id/buttonCommentUpvote"
        app:layout_constraintStart_toEndOf="@+id/buttonCommentUpvote"
        app:layout_constraintTop_toTopOf="@+id/buttonCommentUpvote"
        tools:text="0" />

    <!-- Downvote -->
    <ImageButton
        android:id="@+id/buttonCommentDownvote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Downvote Comment"
        app:srcCompat="@android:drawable/arrow_down_float"
        app:tint="?attr/colorPrimary"
        app:layout_constraintBottom_toBottomOf="@+id/buttonCommentUpvote"
        app:layout_constraintStart_toEndOf="@+id/textViewCommentUpvoteCount"
        app:layout_constraintTop_toTopOf="@+id/buttonCommentUpvote" />

    <TextView
        android:id="@+id/textViewCommentDownvoteCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
        app:layout_constraintBottom_toBottomOf="@+id/buttonCommentDownvote"
        app:layout_constraintStart_toEndOf="@+id/buttonCommentDownvote"
        app:layout_constraintTop_toTopOf="@+id/buttonCommentDownvote"
        tools:text="0" />

    <!-- Reply Button -->
    <ImageButton
        android:id="@+id/buttonCommentReply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Reply to Comment"
        app:layout_constraintBottom_toBottomOf="@+id/buttonCommentUpvote"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/buttonCommentUpvote"
        app:srcCompat="@android:drawable/ic_menu_revert"
        app:tint="?attr/colorPrimary" />

</androidx.constraintlayout.widget.ConstraintLayout>